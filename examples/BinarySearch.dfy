// Задача 2: бинарный поиск в массиве, отсортированном по неубыванию.
// Возвращаем индекс любого вхождения key; если его нет, возвращаем -1.
// При повторах не обещаем ни первое, ни последнее вхождение.
// Проверка: dafny verify examples/BinarySearch.dfy
// Запуск:   dafny run examples/BinarySearch.dfy
//
// Читать программу удобно как контракт и его доказательство:
//   requires  — что обязан обеспечить вызывающий код;
//   ensures   — что метод гарантирует при выполнении requires;
//   invariant — что верно перед проверкой условия каждой итерации.
// Проверка статическая: Dafny рассуждает обо всех допустимых входах,
// а не только о массиве, который затем печатает Main.
//
// method объявляет исполняемый метод. a: array<int> — изменяемый
// одномерный массив целых, key: int — искомое целое число.
// int в Dafny — математические целые без ограничения разрядности.
// array<int> в современном Dafny не допускает null; nullable-вариант
// записывается array?<int>. Поэтому requires a != null здесь не нужен.
// returns (idx: int) объявляет именованный выходной параметр.
// Фигурные скобки { ... } ограничивают тело метода/цикла/ветви if.
// Простые операторы (присваивание, вызов, return, print) завершаются ;.
// Аннотации requires, ensures и invariant здесь записаны без ;.
method BinarySearch(a: array<int>, key: int) returns (idx: int)
  // forall i, j :: P — «для всех i и j верно P». Типы i и j выводятся
  // как int. :: отделяет связанные переменные от тела квантора.
  // A ==> B — импликация: если A истинно, то должно быть истинно B;
  // если A ложно, требований к B эта импликация не предъявляет.
  // 0 <= i < j < a.Length — цепочка сравнений (их конъюнкция).
  // a.Length — длина массива, a[i] — элемент с индексом i.
  // Для любой пары позиций i < j значение слева не больше правого.
  // Это также допускает равные элементы и пустой массив.
  requires forall i, j :: 0 <= i < j < a.Length ==> a[i] <= a[j]
  // Если вернули неотрицательное значение, это допустимый индекс
  // и найденный элемент равен key. && — логическое «и», == — равенство.
  // && вычисляется с сокращением: a[idx] рассматривается лишь после
  // проверки idx < a.Length; неотрицательность дана слева от ==>.
  ensures 0 <= idx ==> idx < a.Length && a[idx] == key
  // При отрицательном результате ключ отсутствует во всём массиве.
  // != — неравенство. Сам контракт допускает любое отрицательное число,
  // хотя конкретная реализация ниже всегда возвращает именно -1.
  ensures idx < 0 ==> forall k :: 0 <= k < a.Length ==> a[k] != key
{
  // var объявляет локальные переменные, := присваивает значения;
  // это не проверка равенства (для неё служит ==).
  // Здесь сразу объявлены lo и hi; их тип int выводится автоматически.
  // Оставшийся диапазон поиска — полуинтервал [lo, hi):
  // lo включён, hi не включён, hi - lo — число оставшихся элементов.
  // При hi == a.Length обращаться к a[hi] нельзя, но хранить такую
  // верхнюю границу можно. Сначала диапазон охватывает весь массив.
  var lo, hi := 0, a.Length;
  while lo < hi
    // while проверяет условие перед каждой итерацией. Скобки вокруг
    // условия необязательны; if / else if / else ниже выбирают ветвь
    // последовательно: следующая проверяется, только если предыдущая ложна.
    // Инварианты проверяются до первой итерации и после каждого её тела.
    // При доказательстве очередной итерации Dafny опирается на них,
    // условие lo < hi и контракт; она не перебирает все итерации.
    // Первый инвариант задаёт корректность границ.
    invariant 0 <= lo <= hi <= a.Length
    // Всё левее lo уже отброшено: там значения строго меньше ключа.
    // Изначально lo == 0, таких индексов нет, и forall истинно.
    invariant forall k :: 0 <= k < lo ==> a[k] < key
    // Всё начиная с hi тоже отброшено: там значения строго больше ключа.
    // Изначально hi == a.Length, и это множество индексов тоже пусто.
    invariant forall k :: hi <= k < a.Length ==> a[k] > key
    // Явного decreases нет: для условия lo < hi Dafny выводит hi - lo.
    // Пока тело выполняется, эта целая мера положительна и на каждом
    // следующем шаге строго уменьшается. Так доказывается завершение.
    // modifies не указан: метод не меняет элементы существующих
    // массивов/объектов. Менять локальные lo и hi при этом разрешено.
  {
    // / для int — целочисленное евклидово деление. Здесь lo и hi
    // неотрицательны, поэтому деление на 2 округляет вниз.
    // Из lo < hi следует lo <= mid < hi: доступ a[mid] безопасен.
    // Сумма lo + hi не переполняется, так как int не ограничен разрядностью.
    var mid := (lo + hi) / 2;
    if a[mid] < key {
      // По отсортированности для всех lo <= k <= mid:
      // a[k] <= a[mid] < key. Поэтому можно отбросить и сам mid,
      // установив lo := mid + 1; левый инвариант сохранится.
      // mid >= старого lo, значит диапазон строго сокращается.
      lo := mid + 1;
    } else if a[mid] > key {
      // Для всех mid <= k < hi: a[k] >= a[mid] > key.
      // Исключаем mid вместе с правой частью, делая его новой границей hi.
      // mid < старого hi, поэтому мера hi - lo снова уменьшается.
      hi := mid;
    } else {
      // Оба строгих сравнения ложны, следовательно a[mid] == key.
      // return mid возвращает значение выходного параметра idx
      // и сразу завершает метод. Его первое постусловие выполнено,
      // а второе неприменимо, поскольку mid >= 0.
      return mid;
    }
  }
  // При выходе lo >= hi, а инвариант даёт lo <= hi; значит lo == hi.
  // Неотброшенных индексов не осталось. Любой допустимый k либо < lo,
  // либо >= hi; соответствующий инвариант исключает равенство a[k] == key.
  // Это доказывает второе постусловие для результата -1.
  return -1;
}

// Main — точка входа при dafny run. У каждого файла свой Main,
// поэтому эти учебные файлы запускаются по отдельности.
method Main() {
  // new int[] [...] создаёт новый массив int с перечисленными значениями.
  // Массив отсортирован, что позволяет доказать requires при вызовах.
  var a := new int[] [1, 3, 5, 7, 9, 11];
  // Метод возвращает одно значение; сохраняем его в новой переменной i.
  var i := BinarySearch(a, 7);
  // print выводит аргументы через запятую последовательно, без
  // автоматических разделителей; "\n" — перевод строки. Ожидаем индекс 3.
  print "BinarySearch([1, 3, 5, 7, 9, 11], 7) = ", i, "\n";
  // Ключа 4 нет; ожидаем -1. Эти два запуска иллюстрируют поведение,
  // но не заменяют доказательство для всех допустимых массивов.
  var j := BinarySearch(a, 4);
  print "BinarySearch([1, 3, 5, 7, 9, 11], 4) = ", j, "\n";
}
