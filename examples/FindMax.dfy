// Задача 1: вернуть индекс максимального элемента непустого массива.
// Проверка: dafny verify examples/FindMax.dfy
// Запуск:   dafny run examples/FindMax.dfy
//
// method — исполняемый метод; a: array<int> — одномерный массив целых.
// array<int> не допускает null (для допуска null нужен array?<int>).
// int — математические целые без переполнения фиксированной разрядности.
// returns (idx: int) объявляет именованный выходной параметр: его можно
// менять в теле и использовать в постусловиях.
// { ... } задаёт блок тела; ; завершает простой оператор.
// requires, ensures и invariant — аннотации, здесь без завершающей ;.
method FindMax(a: array<int>) returns (idx: int)
  // requires — предусловие, обязанность вызывающего кода.
  // a.Length — длина массива; непустота нужна, чтобы индекс 0 был допустим
  // и чтобы максимальный элемент вообще существовал.
  requires a.Length > 0
  // ensures — постусловие, гарантия метода при выполненном requires.
  // 0 <= idx < a.Length означает 0 <= idx && idx < a.Length.
  // Возвращается именно индекс, а не само максимальное значение.
  ensures 0 <= idx < a.Length
  // forall k :: P означает «для всех k верно P»; тип k выводится как int.
  // :: отделяет переменную квантора от формулы; ==> — импликация.
  // Для любого допустимого индекса k должно быть a[k] <= a[idx].
  // Это выражает максимальность без необходимости задавать алгоритм.
  // За пределами массива левая часть импликации ложна: a[k] там читать
  // не требуется. Первое ensures обеспечивает допустимость a[idx].
  ensures forall k :: 0 <= k < a.Length ==> a[k] <= a[idx]
{
  // := — присваивание; == было бы сравнением на равенство.
  // Сначала считаем максимумом первый элемент. Это корректный кандидат,
  // потому что предусловие гарантирует наличие хотя бы одного элемента.
  idx := 0;
  // var объявляет локальную переменную; её тип int выведен автоматически.
  // Рассмотрен префикс [0, i), то есть все позиции от 0 до i - 1.
  // Начинаем с i == 1: префикс уже содержит a[0], выбранный максимум.
  var i := 1;
  while i < a.Length
    // invariant — свойство в начале каждой итерации, перед проверкой
    // условия while. Dafny проверяет его инициализацию, сохранение телом
    // и использует вместе с отрицанием условия цикла при выходе.
    // Первая строка ограничивает длину рассмотренного префикса.
    invariant 1 <= i <= a.Length
    // Кандидат idx всегда находится в уже рассмотренном префиксе.
    // Вместе с границами i это гарантирует безопасность a[idx].
    invariant 0 <= idx < i
    // a[idx] — максимум среди уже просмотренных элементов, но пока
    // не обязательно среди всех: ещё не просмотренный a[i] может быть больше.
    // При i == 1 это сводится к a[0] <= a[0], поэтому инвариант истинен.
    invariant forall k :: 0 <= k < i ==> a[k] <= a[idx]
    // Для завершения Dafny автоматически выводит decreases a.Length - i.
    // Во время выполнения тела эта мера положительна, а i := i + 1
    // уменьшает её на единицу. Вечный цикл невозможен.
    // modifies не требуется: элементы массива не меняются, изменяются
    // лишь локальная i и выходной параметр idx.
  {
    // Условие цикла и инварианты дают 0 <= i < a.Length,
    // поэтому a[i] доступен. Если он больше текущего максимума,
    // выбираем его; все прежние элементы не больше нового кандидата.
    if a[i] > a[idx] {
      idx := i;
    }
    // Если условие if было ложным, a[i] <= a[idx], и кандидат остаётся.
    // После увеличения i префикс включает проверенный элемент:
    // все три инварианта снова выполнены для следующей итерации.
    // Строгое > сохраняет более ранний индекс при равных значениях:
    // реализация возвращает первый максимум, хотя контракт этого не требует.
    i := i + 1;
  }
  // На выходе i >= a.Length; инвариант даёт обратное неравенство.
  // Следовательно i == a.Length: рассмотрен весь массив, и инварианты
  // превращаются в оба ensures. При длине 1 цикл не выполнится ни разу,
  // но доказательство и результат idx == 0 остаются корректными.
  // Явного return не нужно: по достижении конца тела Dafny возвращает
  // текущее значение именованного выходного параметра idx.
}

// Main — точка входа при запуске файла. Примеры с собственным Main
// следует запускать по отдельности, а не объединять все .dfy в один запуск.
method Main() {
  // new int[] [...] выделяет массив и задаёт значения его элементов.
  // Dafny знает его длину, поэтому может доказать предусловие FindMax.
  var a := new int[] [3, 7, 2, 5];
  // Получаем индекс 1; значение максимального элемента — a[1] == 7.
  var i := FindMax(a);
  // print выводит аргументы через запятую один за другим; "\n" — новая
  // строка. Доступ a[i] безопасен благодаря первому ensures FindMax.
  // Этот вывод демонстрирует один случай; статическая верификация выше
  // проверяет метод для любого непустого массива, включая отрицательные
  // значения, повторы и массивы из одного элемента.
  print "FindMax([3, 7, 2, 5]) = ", i, " (a[", i, "] = ", a[i], ")\n";
}
