// Проверка: dafny verify examples/Consecutive.dfy
// Ожидаем сообщение "a postcondition could not be proved on this return path"
// со ссылкой на ensures y % 2 == 0. Это отказ доказать постусловие,
// а не ошибка синтаксиса и не обнаруженный контрпример.
//
// method — исполняемый метод, x: int — входной параметр, а
// returns (y: int) — именованный выходной параметр.
// { ... } ограничивает блок тела, а ; завершает присваивание или вызов.
// int в Dafny — математические целые без ограничения разрядности:
// переполнение здесь не является причиной ошибки верификации.
// requires отсутствует, поэтому контракт должен работать для любого x,
// в том числе нуля и отрицательных целых.
method Consecutive(x: int) returns (y: int)
  // ensures задаёт постусловие: после выполнения результат должен быть чётным.
  // == — проверка равенства, % — евклидов остаток от целочисленного деления.
  // Для положительного делителя 2 остаток всегда 0 или 1, даже при x < 0:
  // например, -3 % 2 == 1. Чётность числа y означает именно y % 2 == 0.
  ensures y % 2 == 0
{
  // := — присваивание; * — умножение, скобки задают порядок вычислений.
  // Это произведение соседних целых: x и x + 1.
  y := x * (x + 1);
  // return не обязателен: выход из тела возвращает текущее значение y.
}

// ПОЧЕМУ УТВЕРЖДЕНИЕ ИСТИННО
// Среди двух соседних целых одно обязательно чётно.
// Более формально, евклидово деление даёт x = 2*q + r,
// где q = x / 2 и r = x % 2, причём r равен 0 или 1.
//   1. r == 0: x = 2*q, поэтому x*(x+1) = 2*(q*(x+1)).
//   2. r == 1: x = 2*q+1, x+1 = 2*(q+1),
//      поэтому x*(x+1) = 2*(x*(q+1)).
// В обоих случаях произведение кратно 2. Доказательство применимо
// и к отрицательным x: евклидово разложение и там имеет остаток 0 или 1.
//
// ПОЧЕМУ АВТОМАТИЧЕСКАЯ ПРОВЕРКА ЗДЕСЬ НЕ ПРОХОДИТ
// После подстановки присваивания в постусловие нужно доказать:
//   (x * (x + 1)) % 2 == 0
// для произвольного целого x. Dafny не запускает метод со всеми x,
// а передаёт логические условия через Boogie SMT-решателю Z3.
// Здесь перемножаются выражения, зависящие от неизвестного x:
// это нелинейная целочисленная арифметика. Её сочетание с % требует
// рассуждений о делимости, а не только линейных неравенств.
// Для общего случая нелинейной целочисленной арифметики нет полного
// алгоритма решения; автоматические решатели используют неполные методы.
// Они умеют доказывать многие отдельные нелинейные факты, но не обязаны
// самостоятельно находить нужное разбиение по чётности и цепочку равенств.
// Поэтому неверно говорить, что Z3 вообще не умеет работать с * или %.
// Конкретно это доказательство ему не удаётся при проверенной конфигурации;
// результат может отличаться с другой версией, настройками и подсказками.
// Само сообщение не означает, что нечётный результат действительно возможен.
//
// КАК ПОМОЧЬ ВЕРИФИКАТОРУ (ЗДЕСЬ НАМЕРЕННО НЕ ДОБАВЛЕНО В КОД)
// Можно явно разобрать случаи x % 2 == 0 и x % 2 == 1, установить
// разложение x через частное и остаток, затем показать произведение как 2*t.
// Для отдельных переходов могут потребоваться доказанные леммы об умножении
// и остатке или цепочки calc; одно добавление if не гарантирует успеха.
// lemma задаёт вспомогательное доказательство, assert требует доказать
// промежуточный факт. Неподтверждённый assume лишь принимает факт на веру
// и потому не является доказательством исходного свойства.
// Здесь исходный минимальный пример оставлен без таких подсказок,
// чтобы можно было воспроизвести именно отказ автоматической верификации.

// Main — демонстрация вычисления на семи входах, а не доказательство
// универсального постусловия. Обычный dafny run сначала проверяет файл
// и остановится из-за ошибки Consecutive, не выполняя Main.
// Чтобы отдельно увидеть результаты без верификации:
//   dafny run --no-verify examples/Consecutive.dfy
// Этот режим позволяет запустить пример, но НЕ подтверждает его контракт.
method Main() {
  // var объявляет локальную переменную; тип int выведен из значения -3.
  var x := -3;
  // while повторяет тело, пока x <= 3. Вызовы идут с -3, -2, ..., 3.
  // Явных invariant/decreases здесь нет; Dafny автоматически выводит
  // меру завершения 3 - x (для <= используется соответствующая догадка).
  // На последней итерации x становится 4, и условие уже ложно.
  // Для этого демонстрационного цикла не нужно доказывать свойства всех
  // напечатанных значений через инвариант: у Main нет такого постусловия.
  while x <= 3 {
    // Вызывается метод Consecutive, возвращённое значение сохраняется в y.
    // При модульной проверке вызывающий код может использовать ensures
    // вызванного метода; но доказанной программа считается лишь тогда,
    // когда проверены и вызывающий код, и тело самого Consecutive.
    var y := Consecutive(x);
    // print последовательно выводит аргументы через запятую; "\n" — новая
    // строка. Ожидаемые произведения: 6, 2, 0, 0, 2, 6, 12;
    // во всех семи строках остаток y % 2 будет равен 0.
    print x, " * ", x + 1, " = ", y, ", y % 2 = ", y % 2, "\n";
    // Обновление счётчика обязательно: без него цикл не завершался бы.
    x := x + 1;
  }
}
